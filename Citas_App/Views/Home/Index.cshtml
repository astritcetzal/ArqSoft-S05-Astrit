@{
    ViewData["Title"] = "Inicio";
}

<div class="hero-container">

    <h1>Sistema de Gestión Médica</h1>

    <p class="lead">
        Plataforma para administrar citas médicas,
        pacientes y personal de manera sencilla y organizada.
    </p>

    <hr />

    <p>
        Selecciona una opción para comenzar.
    </p>

    <div class="actions">

        <a asp-controller="Cita"
               asp-action="Index"
               class="btn-home">
            Gestionar Citas
        </a>

        <a asp-controller="Paciente"
               asp-action="Index"
               class="btn-home">
            Ver Pacientes
        </a>

        <a asp-controller="Medico"
               asp-action="Index"
               class="btn-home">
            Ver Médicos
        </a>

    </div>

</div>