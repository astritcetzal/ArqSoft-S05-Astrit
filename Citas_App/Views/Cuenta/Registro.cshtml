@model Citas_App.Web.ViewModel.RegistroViewModel

@{
    ViewData["Title"] = "Registro";
}

<div class="auth-container">

    <div class="auth-card">

        <div class="auth-card-body">

            <h2 class="auth-title">Crear Cuenta</h2>

            <p class="auth-subtitle">
                Regístrate para comenzar a gestionar tus citas médicas.
            </p>

            <form asp-action="Registro" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>

                <!-- Nombre -->
                <div class="auth-field">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre"
                           placeholder="Ingresa tu nombre"
                           autofocus />
                    <span asp-validation-for="Nombre"></span>
                </div>

                <!-- Apellido -->
                <div class="auth-field">
                    <label asp-for="Apellido">Apellido</label>
                    <input asp-for="Apellido"
                           placeholder="Ingresa tu apellido" />
                    <span asp-validation-for="Apellido"></span>
                </div>

                <!-- Email -->
                <div class="auth-field">
                    <label asp-for="Email">Correo Electrónico</label>
                    <input asp-for="Email"
                           type="email"
                           placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <!-- Rol -->
                <div class="auth-field">
                    <label asp-for="Rol">Tipo de Cuenta</label>

                    <select asp-for="Rol">
                        <option value="Paciente">Paciente</option>
                        <option value="Medico">Médico</option>
                        <option value="Admin">Administrador</option>
                    </select>
                </div>

                <!-- Contraseña -->
                <div class="auth-field">
                    <label asp-for="Password">Contraseña</label>

                    <input asp-for="Password"
                           type="password"
                           placeholder="••••••••" />

                    <span asp-validation-for="Password"></span>
                </div>

                <!-- Confirmar contraseña -->
                <div class="auth-field">
                    <label asp-for="ConfirmPassword">
                        Confirmar Contraseña
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           placeholder="••••••••" />

                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="auth-button">
                    Registrarse
                </button>

            </form>

        </div>

        <div class="auth-footer">
            <span>¿Ya tienes cuenta?</span>

            <a asp-action="Login">
                Inicia sesión aquí
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}